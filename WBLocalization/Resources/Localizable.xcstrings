    "sys.permission.footer": {
      "comment": "权限弹窗说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسم النظام طلبات الأذونات باستخدام InfoPlist.strings بلغة تشغيل العملية. بعد التبديل داخل التطبيق أعد تشغيله لتحديثها، ويظهر كل طلب مرة واحدة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungsdialoge zeichnet das System mit InfoPlist.strings in der Sprache, mit der der Prozess gestartet wurde. Nach einem Wechsel in der App ist ein Neustart nötig. Jeder Dialog erscheint nur einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission prompts are drawn by the system using InfoPlist.strings in the language the process launched with. After switching in the app, relaunch to update them. Each prompt appears only once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限ダイアログはシステムが InfoPlist.strings を使い、プロセス起動時の言語で表示します。アプリ内で切り替えた後は再起動が必要です。各ダイアログは一度しか表示されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы разрешений рисует система, используя InfoPlist.strings на языке запуска процесса. После переключения в приложении нужен перезапуск. Каждый запрос появляется только один раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限弹窗由系统绘制，文案来自 InfoPlist.strings，语言取决于进程启动时的语言。App 内切换后需重启 App 才会更新；每个权限只会弹出一次。"
          }
        }
      }
    },
