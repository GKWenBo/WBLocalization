    "plurals.multi.footer": {
      "comment": "多变量复数说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تحتوي الجملة على عدة أعداد، استخدم Vary by Plural لكل متغير في String Catalog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält ein Satz mehrere Anzahlen, nutze im String Catalog „Vary by Plural“ für jede Variable. Im Chinesischen und Japanischen ist die Argumentreihenfolge anders."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a sentence contains several counts, use “Vary by Plural” for each variable in the String Catalog. Note that argument order differs in Chinese and Japanese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つの文に複数の数がある場合は、String Catalog で変数ごとに「Vary by Plural」を使います。中国語と日本語では引数の順序が英語と異なります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если в предложении несколько чисел, используйте «Vary by Plural» для каждой переменной в String Catalog. В китайском и японском порядок аргументов другой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一句话含多个数量时，在 String Catalog 中对每个变量分别「Vary by Plural」。注意中文、日语的参数顺序与英语不同。"
          }
        }
      }
    },
