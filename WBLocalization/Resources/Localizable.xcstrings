    "fmt.pitfalls.footer": {
      "comment": "格式化常见错误说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتبع Locale.current التبديل داخل التطبيق. استخدم دائمًا الإعدادات المحلية للتطبيق والقوالب بدلًا من dateFormat ثابت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Locale.current folgt dem Sprachwechsel in der App nicht. Formatiere immer mit dem Gebietsschema der App und verwende Vorlagen statt eines festen dateFormat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locale.current does not follow in-app switching. Always format with the app's locale and use templates instead of a fixed dateFormat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Locale.current はアプリ内の切り替えに追従しません。常にアプリのロケールで書式設定し、固定の dateFormat ではなくテンプレートを使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Locale.current не меняется при переключении в приложении. Форматируйте с локалью приложения и используйте шаблоны вместо фиксированного dateFormat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Locale.current 不随 App 内切换变化；展示时必须使用 App 当前 locale，并用模板代替写死的 dateFormat。"
          }
        }
      }
    },
