    "fmt.units.footer": {
      "comment": "单位说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحول الوحدات تلقائيًا بحسب المنطقة، وتختلف أدوات الربط في القوائم بحسب اللغة، فلا تدمجها بالفواصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einheiten werden je nach Region umgerechnet (in den USA Meilen und °F). Auch Listenverknüpfungen sind sprachabhängig – nie einfach mit Kommas verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Units convert automatically by region (miles and °F in the US). List conjunctions also vary by language, so never join with commas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単位は地域に応じて自動変換されます（米国ではマイルと華氏）。リストの接続詞も言語ごとに異なるため、カンマで連結しないでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единицы пересчитываются по региону (в США — мили и °F). Союзы в списках тоже зависят от языка, поэтому не соединяйте элементы запятыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "度量单位按地区自动换算（如美国显示英里与华氏度）；列表连接词也因语言而异，不要用逗号拼接。"
          }
        }
      }
    },
