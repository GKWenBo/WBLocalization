    "input.phone.footer": {
      "comment": "手机号与验证码说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُكتب أرقام الهواتف والرموز والبريد الإلكتروني والمبالغ دائمًا من اليسار إلى اليمين، لذا افرض هذا الاتجاه، ولا تعكس ترتيب خانات الرمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonnummern, Codes, E-Mail-Adressen und Beträge werden immer von links nach rechts geschrieben – erzwinge LTR; auch die Reihenfolge der Code-Felder darf nicht gespiegelt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone numbers, codes, emails and amounts are always written left-to-right, so force LTR for them; the order of code boxes must not mirror either."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話番号、認証コード、メール、金額は常に左から右に書くため LTR に固定します。コード入力欄の順序も反転させてはいけません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефоны, коды, e-mail и суммы всегда пишутся слева направо — принудительно задавайте LTR; порядок ячеек кода тоже не должен отражаться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机号、验证码、邮箱、金额始终从左到右书写，需单独强制 LTR；验证码格子的顺序也不能镜像。"
          }
        }
      }
    },
