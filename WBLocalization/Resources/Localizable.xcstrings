    "fmt.number.footer": {
      "comment": "货币说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي العملة من بياناتك وليس من اللغة؛ أما موضع الرمز والكسور والفواصل فتحددها الإعدادات المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Währung stammt aus deinen Daten, nicht aus der Sprache; Symbolposition, Dezimalstellen und Trennzeichen bestimmt das Gebietsschema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The currency comes from your data, not the language; symbol position, decimals and separators come from the locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨は言語ではなくデータで決まります。記号の位置、小数桁、区切り文字はロケールで決まります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта берётся из данных, а не из языка; положение символа, количество знаков и разделители определяет локаль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "币种来自业务数据，不随语言变化；符号位置、小数位数和分隔符由 locale 决定。"
          }
        }
      }
    },
