    "bidi.footer.copy": {
      "comment": "复制与提交说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محارف العزل غير مرئية: أزلها باستخدام removingBidiControls قبل النسخ أو الإرسال إلى الخادم أو مقارنة السلاسل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Isolationszeichen sind unsichtbar: Entferne sie mit removingBidiControls vor dem Kopieren, Senden oder Vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Isolates are invisible characters: strip them with removingBidiControls before copying, sending to a server or comparing strings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分離文字は不可視です。コピー、サーバー送信、文字列比較の前に removingBidiControls で除去します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символы изоляции невидимы: удаляйте их через removingBidiControls перед копированием, отправкой на сервер или сравнением строк."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隔离符是不可见字符：复制、提交服务端、做字符串比较前用 removingBidiControls 清理。"
          }
        }
      }
    },
    "bidi.footer.name": {
      "comment": "用户内容说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزل المحتوى غير معروف الاتجاه (الأسماء وعناوين المنتجات) بـ FSI…PDI؛ إذ يُعاد ترتيب النص الذي يبدأ أو ينتهي بمحارف محايدة مثل @ و! و# و+."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Isoliere Inhalte mit unbekannter Richtung (Namen, Produkttitel) mit FSI…PDI: Text, der mit neutralen Zeichen wie @, !, # oder + beginnt oder endet, wird sonst umsortiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Isolate content of unknown direction (names, product titles) with FSI…PDI: text that starts or ends with neutral characters such as @, !, # or + gets reordered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方向が不明な内容（名前、商品名）は FSI…PDI で分離します。@、!、#、+ などの中立文字で始まる・終わる内容は並べ替えられてしまいます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изолируйте текст неизвестного направления (имена, названия товаров) с помощью FSI…PDI: текст, начинающийся или заканчивающийся нейтральными символами (@, !, #, +), переставляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入方向未知的内容（昵称、商品名）时用 FSI…PDI 隔离：以 @、!、#、+ 等中性字符开头或结尾的内容会被重新排序。"
          }
        }
      }
    },
    "bidi.footer.phone": {
      "comment": "电话号码说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غلّف أرقام الهواتف والرموز بـ LRI…PDI لفرض الاتجاه من اليسار إلى اليمين، وإلا انتقلت علامة + والفواصل إلى الجهة الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonnummern und Codes mit LRI…PDI umschließen, sonst springen „+“ und Trennzeichen auf die andere Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap phone numbers and codes in LRI…PDI to force left-to-right, otherwise “+” and separators jump to the other side."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話番号やコードは LRI…PDI で囲んで左から右に固定します。そうしないと「+」や区切り文字が反対側に移動します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оборачивайте телефоны и коды в LRI…PDI, иначе «+» и разделители переедут на другую сторону."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机号、验证码等需用 LRI…PDI 强制从左到右，否则「+」和分隔符会跑到另一侧。"
          }
        }
      }
    },
    "bidi.intro": {
      "comment": "双向文本页说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم هذه الأمثلة النص العربي دائمًا لتتمكن من ملاحظة المشكلات بأي لغة واجهة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Beispiele verwenden immer arabischen Text, damit du die Probleme in jeder Sprache siehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These samples always use Arabic text so you can see the issues in any UI language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの例は常にアラビア語のテキストを使うため、どの表示言語でも問題を確認できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В примерах всегда используется арабский текст, чтобы проблемы были видны при любом языке интерфейса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下示例固定使用阿拉伯语文本，在任何界面语言下都能观察到问题。"
          }
        }
      }
    },
