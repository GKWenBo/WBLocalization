    "input.parsing.footer": {
      "comment": "数字解析说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكتب المستخدمون أرقامًا مثل ١٢٣٫٥ لا يستطيع Double(_:) تحليلها؛ استخدم NumberFormatter بالإعدادات المحلية المناسبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabische Nutzer geben evtl. Ziffern wie ١٢٣٫٥ ein, die Double(_:) nicht parsen kann. Verwende einen NumberFormatter mit passendem Gebietsschema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabic users may type digits like ١٢٣٫٥, which Double(_:) can’t parse. Use a NumberFormatter with the matching locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラビア語のユーザーは ١٢٣٫٥ のような数字を入力することがあり、Double(_:) では解析できません。対応するロケールの NumberFormatter を使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользователи могут вводить арабские цифры вроде ١٢٣٫٥, которые Double(_:) не распознаёт. Используйте NumberFormatter с нужной локалью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阿拉伯语用户可能输入 ١٢٣٫٥ 这样的数字，Double(_:) 无法解析，需用对应 locale 的 NumberFormatter。"
          }
        }
      }
    },
