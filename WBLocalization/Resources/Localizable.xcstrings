    "sys.appName.footer": {
      "comment": "App 名称说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع الاسم على الشاشة الرئيسية إعدادات لغة النظام ولا يتغير بالتبديل داخل التطبيق. لعرض الاسم داخل التطبيق، اقرأه من جدول InfoPlist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name auf dem Home-Bildschirm folgt den Spracheinstellungen des Systems; ein Wechsel in der App ändert ihn nicht. Für die Anzeige in der App den Wert der aktuellen Sprache aus der InfoPlist-Tabelle lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Home Screen name follows the system language settings; in-app switching doesn’t change it. To show the name inside the app, read the current language from the InfoPlist table."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面の名前はシステムの言語設定に従い、アプリ内の切り替えでは変わりません。アプリ内で表示するには InfoPlist テーブルから現在の言語の値を読みます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название на экране «Домой» зависит от языковых настроек системы и не меняется при переключении в приложении. Чтобы показать его в приложении, читайте значение из таблицы InfoPlist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主屏幕上的名称由系统按语言设置显示，App 内切换不会改变它。若要在 App 内展示名称，从 InfoPlist 表读取当前语言的值。"
          }
        }
      }
    },
