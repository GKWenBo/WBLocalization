    "fmt.date.footer": {
      "comment": "日期格式说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد ترتيب الحقول وأسماء الأشهر ونظام ١٢/٢٤ ساعة والتقويم على الإعدادات المحلية. تستخدم السعودية التقويم الهجري افتراضيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feldreihenfolge, Monatsnamen, 12/24-Stunden-Format und Kalender hängen vom Gebietsschema ab. In Saudi-Arabien ist der islamische Kalender Standard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Field order, month names, 12/24-hour clock and calendar all depend on the locale. Saudi Arabia uses the Islamic calendar by default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目の順序、月名、12/24 時間制、暦はすべてロケールで決まります。サウジアラビアではイスラム暦が既定です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок полей, названия месяцев, 12/24-часовой формат и календарь зависят от локали. В Саудовской Аравии по умолчанию используется исламский календарь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字段顺序、月份名称、12/24 小时制、历法都由 locale 决定。沙特阿拉伯地区默认使用伊斯兰历。"
          }
        }
      }
    },
    "fmt.date.full": {
      "comment": "完整日期",
