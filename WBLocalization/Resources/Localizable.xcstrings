    "input.alignment.footer": {
      "comment": "文本对齐说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم المحاذاة ‎.natural‎ لحقول النص لتتبع اتجاه التخطيط، ولا تثبّت ‎.left‎."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende für Textfelder die Ausrichtung .natural, damit sie der Layoutrichtung folgen – nie fest .left."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use .natural alignment for text fields so they follow the layout direction; never hard-code .left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストフィールドは .natural で配置し、レイアウト方向に従わせます。.left を固定しないでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте для полей ввода выравнивание .natural, чтобы оно следовало направлению макета; не задавайте .left жёстко."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入框使用 .natural 对齐，跟随布局方向；不要写死 .left。"
          }
        }
      }
    },
