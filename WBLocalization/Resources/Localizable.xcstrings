    "server.response.footer": {
      "comment": "服务端返回说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد الخادم المحتوى باللغة المطلوبة. تُرسَل الأوقات بصيغة ISO 8601 وتُحلَّل بمنسق POSIX ثم تُعرض باللغة الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server liefert Inhalte in der angefragten Sprache. Zeiten werden als ISO 8601 übertragen, mit einem POSIX-Formatter geparst und in der aktuellen Sprache angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returns content for the requested language. Times travel as ISO 8601, are parsed with a POSIX formatter, then displayed in the current language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはリクエストされた言語のコンテンツを返します。時刻は ISO 8601 で送られ、POSIX 形式で解析した後、現在の言語で表示します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер возвращает контент на запрошенном языке. Время передаётся в ISO 8601, разбирается POSIX-форматтером и показывается на текущем языке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端按请求头返回对应语言的内容；时间以 ISO 8601 传输，用 POSIX 格式解析，再按当前语言展示。"
          }
        }
      }
    },
