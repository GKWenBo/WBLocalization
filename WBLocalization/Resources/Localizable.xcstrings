    },
    "sys.controls.footer": {
      "comment": "系统控件说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي عناوين عناصر النظام المضمنة (إلغاء، تعديل، تم) من أطر النظام بلغة التشغيل. أعد التشغيل بعد التبديل أو اضبط العناوين بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingebaute Titel von Systemelementen (Abbrechen, Bearbeiten, Fertig) stammen aus den Systemframeworks in der Startsprache. Nach einem Wechsel neu starten oder die Titel selbst setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in titles of system controls (Cancel, Edit, Done) come from system frameworks in the launch language. Relaunch after switching in the app, or set those titles yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムコントロールの組み込みの文言（キャンセル、編集、完了など）は起動時の言語でシステムフレームワークから取得されます。切り替え後は再起動するか、自分でタイトルを設定します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные надписи системных элементов («Отменить», «Изменить», «Готово») берутся из системных фреймворков на языке запуска. После переключения перезапустите приложение или задайте надписи сами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统控件自带的文案（取消、编辑、完成等）来自系统框架，按进程启动语言显示。App 内切换后需重启，或为这些控件自行设置标题。"
          }
        }
      }
    },
    "sys.launch.body": {
      "comment": "启动屏说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسم النظام شاشة البدء ويخزنها مؤقتًا متجاهلًا النصوص والصور المترجمة، لذا تعرض شاشة البدء في هذا المشروع شعارًا محايدًا لغويًا فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Startbildschirm wird vom System gerendert und zwischengespeichert und ignoriert lokalisierte Texte und Bilder. Daher zeigt er in diesem Projekt nur ein sprachneutrales Logo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The launch screen is rendered and cached by the system and ignores localized text and images, so this project’s launch screen shows only a language-neutral logo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動画面はシステムが描画・キャッシュし、ローカライズされた文字や画像は反映されません。そのため本プロジェクトでは言語に依存しないロゴのみを表示します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран запуска рисует и кэширует система, игнорируя локализованные тексты и изображения, поэтому здесь показан только нейтральный логотип."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动屏由系统渲染并缓存为快照，不会应用本地化文字和本地化图片，因此本项目的启动屏只放与语言无关的 Logo。"
          }
        }
      }
    },
    "sys.permission.camera": {
      "comment": "按钮：请求相机权限",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
