    "plurals.table.footer": {
      "comment": "复数类别说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقع الأرقام نفسها في فئات مختلفة بحسب اللغة: في العربية ٣–١٠ من فئة few، و١١–٩٩ من فئة many؛ وفي الروسية ١ و٢١ من فئة one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselben Zahlen fallen je nach Sprache in andere Kategorien: Im Russischen sind 1 und 21 „one“, 2–4 und 22 „few“, 5–20 „many“; im Arabischen sind 3–10 „few“ und 11–99 „many“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same numbers hit different categories per language: in Russian 1 and 21 are “one”, 2–4 and 22 are “few”, 5–20 are “many”; in Arabic 3–10 are “few” and 11–99 are “many”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ数でも言語によってカテゴリが異なります。ロシア語では 1・21 が one、2〜4・22 が few、5〜20 が many。アラビア語では 3〜10 が few、11〜99 が many です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одни и те же числа попадают в разные категории: в русском 1 и 21 — one, 2–4 и 22 — few, 5–20 — many; в арабском 3–10 — few, 11–99 — many."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同样的数字在不同语言命中不同类别：俄语 1、21 为 one，2–4、22 为 few，5–20 为 many；阿拉伯语 3–10 为 few，11–99 为 many。"
          }
        }
      }
    },
    "rtl.animation.footer": {
      "comment": "动画方向说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تنعكس الإزاحات الأفقية في CGAffineTransform وCALayer تلقائيًا؛ اعكس الإشارة بحسب اتجاه التخطيط للتحرك «للأمام»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontale Verschiebungen in CGAffineTransform und CALayer werden nicht gespiegelt. Kehre das Vorzeichen je nach Layoutrichtung um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal offsets in CGAffineTransform and CALayer are not mirrored. Flip the sign based on layout direction to move “forward”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CGAffineTransform や CALayer の水平移動は反転されません。「前へ」動かすにはレイアウト方向に応じて符号を反転します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Горизонтальные смещения в CGAffineTransform и CALayer не отражаются. Меняйте знак в зависимости от направления макета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CGAffineTransform、CALayer 的水平位移不会自动镜像，「向前」移动需根据布局方向取反。"
          }
        }
      }
    },
    "rtl.animation.play": {
      "comment": "按钮：播放动画",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل الحركة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation abspielen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play Animation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーションを再生"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустить анимацию"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放动画"
          }
        }
      }
    },
    "rtl.auto.footer": {
      "comment": "自动镜像说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنعكس التخطيطات المعتمدة على leading/trailing وأشرطة التقدّم والمنزلقات تلقائيًا. في القوائم الأفقية يبدأ ScrollView في SwiftUI من اليمين، أما UIScrollView وUICollectionView في UIKit فتعكسان المحتوى فقط، لذا مرّر إلى الحافة البادئة بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Layouts mit leading/trailing, Fortschrittsbalken und Schieberegler werden automatisch gespiegelt. Horizontale Listen: SwiftUIs ScrollView beginnt rechts, UIKits UIScrollView und UICollectionView spiegeln nur den Inhalt – scrolle selbst zum Anfang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leading/trailing layouts, progress bars and sliders mirror automatically. For horizontal lists, SwiftUI’s ScrollView starts on the right, but UIKit’s UIScrollView and UICollectionView only mirror their content: scroll to the leading edge yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "leading/trailing を使ったレイアウト、プログレスバー、スライダーは自動的に反転します。横スクロールリストは、SwiftUI の ScrollView は右から始まりますが、UIKit の UIScrollView / UICollectionView は内容が反転するだけなので、先頭側へのスクロールを自分で行います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макеты на leading/trailing, индикаторы прогресса и слайдеры отражаются автоматически. В горизонтальных списках ScrollView в SwiftUI начинается справа, а UIScrollView и UICollectionView в UIKit лишь отражают содержимое — прокрутите к начальному краю сами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 leading/trailing 的布局、进度条、滑块会自动镜像。横向列表：SwiftUI 的 ScrollView 自动从右侧开始；UIKit 的 UIScrollView / UICollectionView 内容会镜像，但初始位置需手动滚到起始边。"
          }
        }
      }
    },
    "rtl.forced.footer": {
      "comment": "强制 LTR 说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى عناصر تشغيل الوسائط والخطوط الزمنية ومحاور الرسوم البيانية من اليسار إلى اليمين لأنها تمثل اتجاهًا فعليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediensteuerung, Zeitleisten und Diagrammachsen stellen eine physische Richtung dar und bleiben links nach rechts (UIKit: .playback, SwiftUI: layoutDirection)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media controls, timelines and chart axes represent physical direction and stay left-to-right (UIKit: .playback, SwiftUI: layoutDirection)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディア操作、タイムライン、グラフの軸は物理的な方向を表すため左から右のままにします（UIKit：.playback、SwiftUI：layoutDirection）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы управления медиа, шкалы времени и оси графиков отражают физическое направление и остаются слева направо (UIKit: .playback, SwiftUI: layoutDirection)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体播放控件、时间轴、图表坐标轴等表示物理方向的内容保持从左到右（UIKit：.playback，SwiftUI：layoutDirection）。"
          }
        }
      }
    },
    "rtl.icons.footer": {
      "comment": "图标方向说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تنعكس الأيقونات التي تعني التقدّم أو الرجوع، بينما لا تنعكس أيقونات التشغيل والعلامة والساعة والشعارات. لا تستخدم arrow.right للتنقّل لأنه لا ينعكس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole für vor/zurück müssen gespiegelt werden (chevron.forward, arrow.forward, eigene Bilder mit gesetzter Direction). Wiedergabe, Häkchen, Uhr und Logos nicht. arrow.right wird nie gespiegelt – nicht für Navigation verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icons that mean forward/back must mirror (chevron.forward, arrow.forward, custom images with Direction set). Play, checkmark, clock and logos don’t. arrow.right never mirrors, so don’t use it for navigation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進む/戻るを表すアイコンは反転させます（chevron.forward、arrow.forward、Direction を設定した画像）。再生、チェック、時計、ロゴは反転しません。arrow.right は反転しないため、ナビゲーションには使いません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значки «вперёд/назад» должны отражаться (chevron.forward, arrow.forward, свои изображения с заданным Direction). Воспроизведение, галочка, часы и логотипы — нет. arrow.right не отражается, не используйте его для навигации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表示前进/后退的图标要镜像（chevron.forward、arrow.forward、设置了 Direction 的自定义图片）；播放键、对勾、时钟、Logo 不镜像。arrow.right 方向固定，不要用于导航。"
          }
        }
      }
    },
