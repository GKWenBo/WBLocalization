    "longtext.truncation.footer": {
      "comment": "截断说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحدد عرضًا ثابتًا وسطرًا واحدًا للنص؛ فالألمانية والروسية أطول غالبًا من الإنجليزية بنسبة ٣٠٪ أو أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Text keine feste Breite mit nur einer Zeile: Deutsch und Russisch sind oft 30 % länger als Englisch, Chinesisch und Japanisch deutlich kürzer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t give text a fixed width and a single line: German and Russian are often 30%+ longer than English, while Chinese and Japanese are much shorter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストに固定幅と 1 行制限を付けないでください。ドイツ語やロシア語は英語より 30% 以上長く、中国語や日本語はずっと短くなります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не задавайте тексту фиксированную ширину и одну строку: немецкий и русский часто на 30% длиннее английского, а китайский и японский — намного короче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要给文本固定宽度和单行限制：德语、俄语通常比英语长 30% 以上，中文、日语则短得多。"
          }
        }
      }
    },
