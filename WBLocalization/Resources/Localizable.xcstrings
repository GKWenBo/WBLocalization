{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "basic.api.footer.swiftui": {
      "comment": "SwiftUI 取值 API 说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يترجم Text إلا القيم الحرفية؛ أما متغير String فيُعرض كما هو. على iOS لا يتبع String(localized:) التبديل داخل التطبيق حتى إعادة التشغيل، لذا مرّر bundle: .localized."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text lokalisiert nur Literale; eine String-Variable wird unverändert angezeigt. Unter iOS folgt String(localized:) dem Sprachwechsel in der App erst nach einem Neustart – übergib daher bundle: .localized."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text only localizes string literals; a String variable is shown verbatim. On iOS, String(localized:) ignores in-app switching until relaunch, so pass bundle: .localized."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Text はリテラルのみローカライズし、String 変数はそのまま表示されます。iOS の String(localized:) は再起動までアプリ内の切り替えに追従しないため、bundle: .localized を渡します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Text локализует только литералы; переменная String отображается как есть. В iOS String(localized:) не учитывает переключение в приложении до перезапуска — передавайте bundle: .localized."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Text 只有传入字面量时才会本地化，传入 String 变量会原样显示 key。iOS 上 String(localized:) 默认不跟随 App 内切换（重启后才变），需传入 bundle: .localized。"
          }
        }
      }
    },
    "basic.api.footer.uikit": {
      "comment": "UIKit 取值 API 说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمر NSLocalizedString عبر الحزمة المستبدلة فيتبع التبديل داخل التطبيق فورًا. أما String(localized:) على iOS فلا يتبعه حتى إعادة التشغيل، لذا مرّر bundle: .localized."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NSLocalizedString läuft über das ausgetauschte Bundle und folgt dem Sprachwechsel sofort. String(localized:) tut das unter iOS erst nach einem Neustart – übergib daher bundle: .localized."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NSLocalizedString goes through the swapped bundle and follows in-app switching immediately. On iOS, String(localized:) does not until relaunch, so pass bundle: .localized."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NSLocalizedString は差し替えた Bundle を経由するため即座に追従します。iOS の String(localized:) は再起動まで追従しないため、bundle: .localized を渡します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NSLocalizedString проходит через подменённый бандл и сразу учитывает переключение. String(localized:) в iOS — только после перезапуска, поэтому передавайте bundle: .localized."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NSLocalizedString 经过框架的 Bundle 替换，会即时跟随 App 内切换；iOS 上 String(localized:) 默认不会（重启后才变），需传入 bundle: .localized。"
          }
        }
      }
    },
    "basic.city": {
      "comment": "城市名，作为插值参数",
      "extractionState": "manual",
