    "plurals.single.footer": {
      "comment": "单个数量说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد صيغ جمع في الصينية واليابانية، لكن يمكنك تخصيص حالة الصفر؛ إذ تدعم Apple الحالة zero في جميع اللغات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinesisch und Japanisch kennen keine Pluralformen, aber den Fall „zero“ kannst du trotzdem anpassen – Apple unterstützt ihn in jeder Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinese and Japanese have no plural forms, but you can still customize zero: Apple supports the zero case in every language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中国語と日本語には複数形がありませんが、zero は個別に設定できます。Apple はすべての言語で zero をサポートします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В китайском и японском нет форм множественного числа, но вариант zero можно задать отдельно — Apple поддерживает его для всех языков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中文、日语没有复数变化，但可以单独为 0 配置 zero 文案：Apple 对所有语言都支持 zero。"
          }
        }
      }
    },
