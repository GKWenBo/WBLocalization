      }
    },
    "basic.concat.footer": {
      "comment": "拼接说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الدمج إلى إفساد ترتيب الكلمات وصيغ الجمع. استخدم جملًا كاملة مع قواعد الجمع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkettung zerstört Wortstellung und Pluralformen. Verwende vollständige Sätze mit Pluralregeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concatenation breaks word order and plurals (e.g. “1 new messages”). Use complete sentences with plural rules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連結すると語順や複数形が崩れます。複数形ルール付きの完全な文を使いましょう。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конкатенация ломает порядок слов и склонение («1 новых сообщений»). Используйте целые фразы с правилами множественного числа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拼接会破坏语序和单复数（英语出现 “1 new messages”，俄语格变化错误）。应使用完整句子 + 复数规则。"
          }
        }
      }
    },
