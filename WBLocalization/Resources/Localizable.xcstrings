    "basic.positional.footer": {
      "comment": "位置参数说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختلف ترتيب الوسائط بحسب اللغة، لذا استخدم دائمًا المحددات الموضعية مثل %1$@ و%2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reihenfolge der Argumente ist je nach Sprache unterschiedlich. Verwende daher immer Positionsangaben wie %1$@ und %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Argument order varies by language, so always use positional specifiers such as %1$@ and %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引数の順序は言語によって異なるため、%1$@ や %2$@ などの位置指定を必ず使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок аргументов зависит от языка, поэтому всегда используйте позиционные спецификаторы, например %1$@ и %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数顺序因语言而异（中文名字在前，英语、日语城市在前），必须使用 %1$@、%2$@ 这样的位置参数。"
          }
        }
      }
    },
