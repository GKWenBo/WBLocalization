    "server.cache.footer": {
      "comment": "缓存说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تتضمن مفاتيح التخزين المؤقت اللغة، وإلا استمر عرض محتوى اللغة السابقة. افتح هذه الصفحة ثم بدّل اللغة وعد للمقارنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache-Schlüssel müssen die Sprache enthalten, sonst bleibt nach einem Wechsel der alte Inhalt sichtbar. Öffne diese Seite, wechsle die Sprache und vergleiche danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache keys must include the language, or old-language content keeps showing after a switch. Open this page, switch languages, then come back to compare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュのキーには言語を含める必要があります。含めないと切り替え後も古い言語の内容が表示されます。このページを開いてから言語を切り替え、戻って比較してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ кэша должен содержать язык, иначе после переключения останется старый контент. Откройте эту страницу, смените язык и вернитесь, чтобы сравнить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存 key 必须包含语言，否则切换语言后仍显示旧语言的内容。先打开本页，再切换语言回来对比。"
          }
        }
      }
    },
    "server.header.footer": {
      "comment": "请求头说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل URLSession الترويسة Accept-Language بحسب لغة النظام ولا يعرف بالتبديل داخل التطبيق، لذا اضبطها بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "URLSession sendet Accept-Language anhand der Systemsprache und kennt den Wechsel in der App nicht – setze den Header selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URLSession sends Accept-Language based on the system language and doesn’t know about in-app switching, so set it yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URLSession はシステム言語に基づいて Accept-Language を送信し、アプリ内の切り替えを認識しないため、自分で設定します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "URLSession отправляет Accept-Language по языку системы и не знает о переключении в приложении — задавайте его сами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URLSession 默认按系统语言发送 Accept-Language，不会感知 App 内切换，需要手动设置。"
          }
        }
      }
    },
    "server.loading": {
      "comment": "加载中提示",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحميل…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
