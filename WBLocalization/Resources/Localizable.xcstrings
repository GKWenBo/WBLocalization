    "longtext.buttons.footer": {
      "comment": "按钮布局说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل المحتوى يحدد عرض الأزرار، وبدّل من الأفقي إلى العمودي عند ضيق المساحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den Inhalt die Breite der Schaltflächen bestimmen und wechsle bei Platzmangel von horizontal zu vertikal (SwiftUI: ViewThatFits, UIKit: UIStackView.axis je nach Breite)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let content size the buttons and switch from horizontal to vertical when space runs out (SwiftUI: ViewThatFits, UIKit: switch UIStackView.axis by width)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタン幅は内容で決め、幅が足りないときは横並びから縦並びに切り替えます（SwiftUI：ViewThatFits、UIKit：幅に応じて UIStackView.axis を切り替え）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть ширину кнопок задаёт содержимое, а при нехватке места раскладка переключается с горизонтальной на вертикальную (SwiftUI: ViewThatFits, UIKit: смена UIStackView.axis)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按钮宽度由内容决定；空间不足时自动从横排切换为竖排（SwiftUI：ViewThatFits，UIKit：按宽度切换 UIStackView.axis）。"
          }
        }
      }
    },
    "longtext.compound": {
      "comment": "示例标题，德语为一个很长的复合词",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات أمان الحساب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontosicherheitseinstellungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Security Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのセキュリティ設定"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки безопасности учётной записи"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户安全设置"
          }
        }
      }
    },
    "longtext.compound.footer": {
      "comment": "长复合词说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تقسيم الكلمات الألمانية المركبة عند المسافات، فيُقتطع السطر الواحد. في UIKit اسمح بعدة أسطر واضبط hyphenationFactor، وفي SwiftUI استخدم minimumScaleFactor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutsche Komposita lassen sich nicht an Leerzeichen umbrechen, eine einzelne Zeile wird abgeschnitten. In UIKit mehrere Zeilen erlauben und hyphenationFactor setzen (neuere Systeme trennen Deutsch automatisch, iOS 15/16 brauchen es explizit). In SwiftUI minimumScaleFactor verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "German compounds can’t wrap at spaces, so a single line truncates. In UIKit allow multiple lines and set hyphenationFactor (newer systems hyphenate German by default; iOS 15/16 need it explicitly). In SwiftUI use minimumScaleFactor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドイツ語の複合語はスペースで折り返せないため、1 行だと省略されます。UIKit では複数行を許可して hyphenationFactor を設定し（新しいシステムではドイツ語は既定でハイフネーション、iOS 15/16 は明示的な設定が必要）、SwiftUI では minimumScaleFactor を使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немецкие составные слова нельзя перенести по пробелу, и одна строка обрезается. В UIKit разрешите несколько строк и задайте hyphenationFactor (новые системы переносят немецкий автоматически, в iOS 15/16 нужно явно). В SwiftUI используйте minimumScaleFactor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "德语复合词无法在空格处换行，单行会被截断。UIKit 允许多行并设置 hyphenationFactor（新系统对德语默认断字，iOS 15/16 需显式设置）；SwiftUI 可用 minimumScaleFactor 缩小字号。"
          }
        }
      }
    },
    "longtext.sample": {
      "comment": "示例长句",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
