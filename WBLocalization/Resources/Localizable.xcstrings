    "images.direction.footer": {
      "comment": "方向性图片说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط Direction على Left to Right في الأصل لينقلب تلقائيًا، واستخدم imageFlippedForRightToLeftLayoutDirection() للصور المُنشأة أثناء التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze im Asset Direction auf „Left to Right“, dann wird es bei RTL gespiegelt. Für zur Laufzeit erzeugte Bilder imageFlippedForRightToLeftLayoutDirection() verwenden (SwiftUI: flipsForRightToLeftLayoutDirection)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Direction to Left to Right in the asset and it flips in RTL. For images created at runtime, use imageFlippedForRightToLeftLayoutDirection() (SwiftUI: flipsForRightToLeftLayoutDirection)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アセットの Direction を Left to Right にすると RTL で自動的に反転します。実行時に生成した画像には imageFlippedForRightToLeftLayoutDirection()（SwiftUI：flipsForRightToLeftLayoutDirection）を使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте в ассете Direction = Left to Right — в RTL изображение отразится. Для изображений, созданных во время работы, используйте imageFlippedForRightToLeftLayoutDirection() (SwiftUI: flipsForRightToLeftLayoutDirection)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Asset 中把 Direction 设为 Left to Right，RTL 下会自动翻转；运行时生成的图片用 imageFlippedForRightToLeftLayoutDirection()（SwiftUI：flipsForRightToLeftLayoutDirection）。"
          }
        }
      }
    },
    "images.localized.footer": {
      "comment": "本地化图片说明",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قدّم نسخًا لكل لغة من الصور التي تحتوي على نص، ووسم كل لغة صراحةً بما فيها لغة التطوير، وإلا عادت إلى الإنجليزية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle für Bilder mit Text sprachspezifische Varianten bereit (Asset Catalog → Localize) und kennzeichne jede Sprache explizit, auch die Entwicklungssprache – sonst wird Englisch verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provide per-language variants for images with text (Asset Catalog → Localize) and tag every language explicitly, including the development language, or it falls back to English."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を含む画像は言語ごとに用意し（Asset Catalog → Localize）、開発言語も含めてすべて明示的に指定します。指定しないと英語にフォールバックします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для изображений с текстом создавайте варианты для каждого языка (Asset Catalog → Localize) и явно помечайте все языки, включая язык разработки, иначе будет использован английский."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含文字的图片要按语言提供变体（Asset Catalog → Localize），并为每种语言（包括开发语言）显式标注，否则会回退到英文。"
          }
        }
      }
    },
