{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "主屏幕上显示的 App 名称，尽量简短（主屏幕约 12 个字符后截断）",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "WB للترجمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WB Lokalisierung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WB Localize"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WBローカライズ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WB Локализация"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WB本地化"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "系统相机权限弹窗中的说明",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط صورًا لترى كيف تتبع طلبات الأذونات لغة التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm Fotos auf, um zu sehen, wie Berechtigungsdialoge der App-Sprache folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos to see how permission prompts follow the app language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を撮影し、権限ダイアログがアプリの言語に従う様子を確認します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте фото, чтобы увидеть, как запросы разрешений следуют языку приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄照片，演示权限弹窗如何随语言切换。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "系统定位权限弹窗中的说明",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم موقعك لترى كيف تتبع طلبات الأذونات لغة التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende deinen Standort, um zu sehen, wie Berechtigungsdialoge der App-Sprache folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your location to see how permission prompts follow the app language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を使用し、権限ダイアログがアプリの言語に従う様子を確認します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте геопозицию, чтобы увидеть, как запросы разрешений следуют языку приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取当前位置，演示权限弹窗如何随语言切换。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "系统相册权限弹窗中的说明",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورًا لترى كيف تتبع طلبات الأذونات لغة التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Fotos aus, um zu sehen, wie Berechtigungsdialoge der App-Sprache folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos to see how permission prompts follow the app language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を選択し、権限ダイアログがアプリの言語に従う様子を確認します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте фото, чтобы увидеть, как запросы разрешений следуют языку приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片，演示权限弹窗如何随语言切换。"
          }
        }
      }
    }
  },
  "version": "1.0"
}